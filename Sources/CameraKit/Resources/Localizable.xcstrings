    "Ha fallado el arranque de la cámara.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Start der Kamera ist fehlgeschlagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera failed to start."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le démarrage de la caméra a échoué."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvio della fotocamera non riuscito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラの起動に失敗しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 시작에 실패했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao iniciar a câmera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось запустить камеру."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机启动失败。"
          }
        }
      }
    },
