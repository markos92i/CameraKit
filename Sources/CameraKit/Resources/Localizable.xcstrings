    "No se ha podido iniciar la grabación. La cámara no está lista.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme konnte nicht gestartet werden. Die Kamera ist nicht bereit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording couldn't start. The camera isn't ready."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer l'enregistrement. La caméra n'est pas prête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare la registrazione. La fotocamera non è pronta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録画を開始できませんでした。カメラの準備ができていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹화를 시작할 수 없습니다. 카메라가 준비되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar a gravação. A câmera não está pronta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось начать запись. Камера не готова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法开始录制。相机尚未就绪。"
          }
        }
      }
    },
