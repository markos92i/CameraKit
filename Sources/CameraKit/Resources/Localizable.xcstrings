{
  "sourceLanguage": "es",
  "strings": {
    "Acceso a cámara interrumpido. \n\nAlgún proceso de mayor prioridad ha bloqueado el acceso.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kamerazugriff wurde unterbrochen.\n\nEin Prozess mit höherer Priorität hat den Zugriff blockiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access was interrupted.\n\nA higher-priority process blocked access."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès à la caméra a été interrompu.\n\nUn processus plus prioritaire a bloqué l'accès."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso alla fotocamera è stato interrotto.\n\nUn processo con priorità più alta ha bloccato l'accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラへのアクセスが中断されました。\n\n優先度の高いプロセスがアクセスをブロックしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 접근이 중단되었습니다.\n\n우선순위가 더 높은 프로세스가 접근을 차단했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à câmera foi interrompido.\n\nUm processo de prioridade mais alta bloqueou o acesso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к камере прерван.\n\nДоступ заблокировал процесс с более высоким приоритетом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机访问已中断。\n\n更高优先级的进程阻止了访问。"
          }
        }
      }
    },
