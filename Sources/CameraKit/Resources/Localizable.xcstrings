    "No tenemos permiso para acceder a la cámara o al micrófono. \n\nCambia la configuración en ajustes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben keine Berechtigung für den Zugriff auf Kamera oder Mikrofon.\n\nÄndere die Konfiguration in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We don't have permission to access the camera or microphone.\n\nChange the configuration in Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'avons pas l'autorisation d'accéder à la caméra ou au micro.\n\nModifiez la configuration dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non abbiamo il permesso di accedere alla fotocamera o al microfono.\n\nModifica la configurazione nelle impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラまたはマイクへのアクセスが許可されていません。\n\n設定で変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라나 마이크에 접근할 권한이 없습니다.\n\n설정에서 변경해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não temos permissão para acessar a câmera ou o microfone.\n\nMude a configuração nos ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У нас нет доступа к камере или микрофону.\n\nИзмените конфигурацию в настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们没有权限访问相机或麦克风。\n\n请在设置中更改配置。"
          }
        }
      }
    },
